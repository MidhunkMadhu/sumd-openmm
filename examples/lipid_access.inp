# Replace paths, selections and targets with values for your system.
force_field = AMBER
topology_file = system.parm7
coordinate_file = system.rst7
platform = CUDA
temp = 300
dt = 0.002
window_ps = 20
cv_sample_ps = 1
max_cycles = 500
output_dir = sumd_run
metric_1_type = distance
metric_1_a = :POPC@P
metric_1_b = :160
metric_1_role = supervise
metric_1_direction = decrease
metric_1_target = 6
metric_2_type = mindist
metric_2_a = :POPC
metric_2_b = :150-170
metric_2_role = monitor
