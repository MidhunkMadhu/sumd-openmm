# Replace paths, selections and targets with values for your system.
force_field = AMBER
topology_file = system.parm7
coordinate_file = system.rst7
platform = CUDA
temp = 300
dt = 0.002
window_ps = 20
cv_sample_ps = 1
max_cycles = 500
output_dir = sumd_run
metric_1_type = dihedral
metric_1_a = :45@N
metric_1_b = :45@CA
metric_1_c = :45@CB
metric_1_d = :45@CG
metric_1_role = supervise
metric_1_direction = toward
metric_1_target = 180
metric_1_tolerance = 15
# For a full positive rotation: set direction = increase, remove target
# and tolerance, then set metric_1_target_delta = 180.
