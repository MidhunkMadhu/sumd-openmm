# ============================================================
# SuMD on OpenMM - TAAR1 8JLP + ralmitaront (UJU), entry into pocket 2
#
# One file, two blocks:
#   1. MD_openmm keys  - identical meaning to a production .inp; parsed by
#                        MD_openmm's own build_inputs() (bundled in the
#                        package). Keep these the same
#                        as the production runs you want to compare with.
#   2. SuMD keys       - parsed by sumd_openmm/config.py.
#
# Run from the system directory, as for production:
#   sumd-openmm taar1_ral_sumd.inp --dry-run
#   sumd-openmm taar1_ral_sumd.inp
#   (MPI: srun sumd-openmm taar1_ral_sumd.inp, with parallel = mpi below)
#
# Always --dry-run first: it prints the residues every mask resolved to and
# the initial CV1/CV2 without simulating anything.
# ============================================================


# ============================================================
# 1. MD_openmm keys (copied from step7_production.inp)
# ============================================================

force_field             = AMBER

topology_file           = step5_input.parm7
# Starting structure: ligand placed in bulk, equilibrated (e.g. a step6.7 output).
# Any format openmm_production.py accepts: rst7, OpenMM .xml state, .chk.
coordinate_file         = step6.7_production.xml

continuation            = yes      # keep velocities from coordinate_file
genvel                  = no
reset_step_and_time     = no
rewrap_coordinates      = yes

platform                = CUDA
cuda_precision          = single

# nstep, nstdcd, output_* and checkpoint keys are ignored by SuMD: it runs
# by window and writes its own outputs under output_dir.

dt          = 0.002

coulomb     = PME
ewald_Tol   = 0.0005

vdw         = Force-switch
r_on        = 1.0
r_off       = 1.2

temp        = 310
fric_coeff  = 1

pcouple     = yes
p_ref       = 1.0
p_type      = membrane
p_XYMode    = XYIsotropic
p_ZMode     = ZFree
p_tens      = 0.0
p_freq      = 100

cons        = HBonds
rest        = no                   # SuMD windows must be unbiased: no restraints

lj_lrc      = no
e14scale    = 1.0


# ============================================================
# 2. SuMD keys
# ============================================================

output_dir              = sumd_ral_rep01
random_seed             = 101      # one seed per independent SuMD entry


# ---------------- supervision mode
# single      : Amber-reference behaviour; CV2 measured and logged only. Default.
# stratified  : accept on CV1 exactly as single; CV2 decides which saved
#               state seeds the next window (recommended for production).
# joint       : slope rule on w1*z1 + w2*z2. Selection-biased; comparison only.
supervision             = stratified


# ---------------- CV1: ligand progress
# rmsd     : ligand RMSD to the bound pose after superposing receptor CA
#            (cpptraj "fit, then rms nofit" - keeps the ligand's translation)
# distance : ligand COM to site COM (classic SuMD)
# mindist  : minimum distance ligand to site
cv1_type                = rmsd

# Masks are full Amber/cpptraj masks (with the ':'), resolved once by ParmEd.
# ':N' is the N-th residue in FILE ORDER, as in cpptraj.
cv1_traj_selection      = :UJU&!@H=
cv1_ref_selection       = :UJU&!@H=
cv1_expect              = UJU      # abort if the mask hits anything else

# Receptor CA for the superposition. Set the upper bound to the last receptor
# residue of THIS topology; consider TM-helix CA only to keep floppy loops
# and termini out of the fit.
align_traj_selection    = :1-300@CA
align_ref_selection     = :1-300@CA

# Bound pose (target of the RMSD), same atom naming/order as the topology
# for the selected atoms - the driver checks names pairwise.
reference_structure     = ref_8jro_pocket2_bound.pdb

mass_weighted           = no       # cpptraj default: unweighted
colvarcut               = 2.0      # A; converged when CV1 < cut and slope <= 0

# Only for cv1_type = distance | mindist:
# cv1_site_selection    = :85,179,180&!@N,CA,C,O,H=


# ---------------- CV2: pocket-2 gate aperture
# Min heavy-atom distance, F154(4.56) side chain to T197(5.45) side chain.
# In the analysis topologies biological = topology + 18, so F154 -> :136 and
# T197 -> :179. THIS SYSTEM MAY BE NUMBERED DIFFERENTLY: the expect keys make
# the run abort if the residue names do not match.
cv2_selection_a         = :136&!@N,CA,C,O,H=
cv2_selection_b         = :179&!@N,CA,C,O,H=
cv2_expect_a            = PHE
cv2_expect_b            = THR
cv2_direction           = increase # gate opening = larger aperture
gate_open_cutoff        = 4.70     # A, GMM boundary (closed 3.92, open 5.96)


# ---------------- stratified seeding
gate_strata             = 2        # 2 = open/closed at gate_open_cutoff; >2 = CV2 quantile bins
cv1_band_width          = 1.0      # A
frontier_bands          = 1        # frontier = best band reached + this many behind
pool_per_cell           = 20       # most recent states kept per (band, stratum) cell


# ---------------- joint mode only
joint_weights           = 1.0, 1.0
# joint_mu              = 15.0, 4.2   # default: taken from the first window
# joint_sigma           = 3.0, 0.5


# ---------------- cycle control
window_ps               = 20       # reference TIME_WINDOW_PS
cv_sample_ps            = 1.0      # CV sample and DCD frame interval
max_cycles              = 500      # reference MAXSTEP
max_retries_per_parent  = 8
on_retry_exhaustion     = accept_best   # accept_best | step_back
retry_velocities        = reassign      # reassign (new logged seed) | keep (Amber-like)
require_significant_slope = no     # yes: progress needs slope < 0 and |slope| > 2 SE
slope_points            = all      # all | 5 (Amber reference 5-point estimator)


# ---------------- multiple walkers (mwSuMD-style)
# walkers = 1 + walker_score = slope is classic SuMD.
# walkers = auto : 1 in serial mode, one walker per MPI rank in MPI mode.
walkers                 = 1
walker_score            = slope    # slope | smscore | dmscore (dmscore: gate-biased)


# ---------------- parallel execution
# serial : one process, one GPU; walkers run one after another.
# mpi    : one MPI rank per GPU, walkers of a batch run at the same time.
#          Launch with mpirun/srun; needs mpi4py. output_dir must be on a
#          filesystem shared by all nodes.
parallel                = serial

# Only for parallel = mpi:
# multi_node : one rank per node, one GPU per node (aborts if 2 ranks share a node)
# multi_gpu  : several ranks per node, GPU chosen by node-local rank; also
#              covers several nodes with several GPUs each
mpi_mode                = multi_node

# auto      : multi_node -> OpenMM's default GPU on each node
#             multi_gpu  -> local rank k uses GPU k (or GPU 0 if the scheduler
#                           already bound one GPU per rank)
# 0,1,2,3   : multi_gpu  -> local rank k uses the k-th listed GPU
#             multi_node -> first entry used on every node
gpu_devices             = auto


# ---------------- engine / output
method                  = cMD      # GaMD is refused: not available in OpenMM here
dcd_stride              = 1
keep_rejected_dcd       = no
restore_check           = yes      # verify Epot after every state restore
