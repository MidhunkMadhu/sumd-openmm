# Replace paths, selections and targets with values for your system.
force_field = AMBER
topology_file = system.parm7
coordinate_file = system.rst7
platform = CUDA
temp = 300
dt = 0.002
window_ps = 20
cv_sample_ps = 1
max_cycles = 500
output_dir = sumd_run
seeding = stratified
band_width = 1
metric_1_type = distance
metric_1_a = :LIG
metric_1_b = :110
metric_1_role = supervise
metric_1_direction = decrease
metric_1_target = 4
metric_2_type = distance
metric_2_a = :45
metric_2_b = :210
metric_2_role = stratify
metric_2_bins = 7,10,13
metric_3_type = angle
metric_3_a = :12@CA
metric_3_b = :60@CA
metric_3_c = :98@CA
metric_3_role = monitor
