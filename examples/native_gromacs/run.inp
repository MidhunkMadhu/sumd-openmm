# Shared fit/ligand masks and five-point supervision from supervisedmdamber.
engine = gromacs
force_field = GROMACS
topology_file = topol.top
gmx_include = toppar
coordinate_file = equilibrated_whole.gro
gromacs_mdp = production.mdp
gromacs_executable = gmx_mpi
gromacs_threads = auto
platform = GPU
genvel = no
dt = 0.002
temp = 310
method = cMD
parallel = mpi
mpi_mode = multi_gpu
walkers = auto
gpu_devices = auto
window_ps = 20
cv_sample_ps = 0.04
dcd_stride = 25
slope_points = 5
max_cycles = 100
max_retries_per_parent = 100
retry_velocities = keep
random_seed = 2026
output_dir = sumd_run
selection_syntax = cpptraj
metric_1_name = ligand_rmsd
metric_1_type = rmsd_displacement
metric_1_fit = :1-313@CA
metric_1_reference_fit = :1-313@CA
metric_1_a = :314&!@H=
metric_1_reference_a = :314&!@H=
metric_1_reference = ref_example.pdb
metric_1_role = supervise
metric_1_direction = decrease
metric_1_target = 2.0
