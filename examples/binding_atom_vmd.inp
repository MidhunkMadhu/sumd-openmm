# Replace paths, selections and targets with values for your system.
force_field = AMBER
topology_file = system.parm7
coordinate_file = system.rst7
platform = CUDA
temp = 300
dt = 0.002
window_ps = 20
cv_sample_ps = 1
max_cycles = 500
output_dir = sumd_run
selection_syntax = vmd
metric_1_type = distance
metric_1_a = resname LIG and not name "H.*"
metric_1_b = resid 112 and name NZ
metric_1_role = supervise
metric_1_direction = decrease
metric_1_target = 4
