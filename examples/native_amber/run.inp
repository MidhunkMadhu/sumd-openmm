# Build-only native Amber example. Supply the prepared input files.
engine = amber
force_field = AMBER
topology_file = example.parm7
coordinate_file = example.rst7
amber_mdin = production.mdin
amber_executable = pmemd.hip
amber_threads = auto
genvel = no
dt = 0.002
temp = 310
method = cMD
window_ps = 20
cv_sample_ps = 0.04
dcd_stride = 25
slope_points = 5
max_cycles = 100
max_retries_per_parent = 100
retry_velocities = keep
random_seed = 2026
output_dir = sumd_run
selection_syntax = cpptraj
metric_1_name = ligand_rmsd
metric_1_type = rmsd_displacement
metric_1_fit = :1-313@CA
metric_1_reference_fit = :1-313@CA
metric_1_a = :314&!@H=
metric_1_reference_a = :314&!@H=
metric_1_reference = ref_example.pdb
metric_1_role = supervise
metric_1_direction = decrease
metric_1_target = 2.0
