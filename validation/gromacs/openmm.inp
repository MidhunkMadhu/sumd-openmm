engine = openmm
force_field = GROMACS
topology_file = system.top
coordinate_file = system.gro
gromacs_mdp = production.mdp
platform = CPU
gromacs_threads = 1
dt = 0.0001
temp = 300
genvel = no
window_ps = 0.006
cv_sample_ps = 0.002
max_cycles = 2
max_retries_per_parent = 0
retry_velocities = keep
random_seed = 42
output_dir = openmm_output
metric_1_type = distance
metric_1_a = indices:0
metric_1_b = indices:2
metric_1_direction = decrease
metric_1_target = -1
check_stride = 1

metric_1_role = supervise

integrator = verlet
cons = None
coulomb = CutoffPeriodic
vdw = No-switch
r_off = 1.0
lj_lrc = no
pcouple = no
rewrap_coordinates = no
reset_step_and_time = no
