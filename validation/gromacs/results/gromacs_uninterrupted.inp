engine = gromacs
force_field = GROMACS
topology_file = argon.top
coordinate_file = argon.gro
gromacs_mdp = production.mdp
platform = CPU
gromacs_threads = 1
dt = 0.0001
temp = 300
genvel = no
window_ps = 0.006
cv_sample_ps = 0.002
max_cycles = 3
max_retries_per_parent = 0
retry_velocities = keep
random_seed = 42
output_dir = gromacs_uninterrupted
metric_1_type = distance
metric_1_a = indices:0
metric_1_b = indices:2
metric_1_direction = decrease
metric_1_target = -1
check_stride = 1

metric_1_role = supervise

gromacs_executable = gmx
